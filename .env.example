# SQLite database file. Relative paths are resolved from prisma/.
DATABASE_URL="file:./dev.db"

# Owner password. When set, every page and action requires signing in.
# Leave unset only for local use on your own machine.
# NEXUS_PASSWORD="choose-a-long-unique-password"

# Optional: separate key for signing session cookies (defaults to NEXUS_PASSWORD).
# Changing either value signs everyone out.
# SESSION_SECRET="a-long-random-string"
